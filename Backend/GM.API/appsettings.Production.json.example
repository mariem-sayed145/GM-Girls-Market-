{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:<YOUR_SQL_SERVER_HOST>,1433;Initial Catalog=GMDb;Persist Security Info=False;User ID=<YOUR_SQL_USER>;Password=<YOUR_STRONG_PASSWORD>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "<GENERATE_64_CHAR_HEX_OR_BASE64_SECRET_KEY>",
    "Issuer": "https://api.girlsmarket.com",
    "Audience": "https://girlsmarket.com",
    "ExpirationMinutes": 60
  },
  "Cors": {
